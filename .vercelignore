# Deploys run from the repo root (Root Directory = platform; deploying from
# inside platform/ doubles the path — see registers/umuve_platform.md).
# Allowlist only what the platform build needs: the repo is ~4GB with the iOS
# project + marketing assets, and Vercel caps uploads at 100MB.
/*
!/platform
platform/node_modules
platform/.next
platform/.vercel

# The SAME repo feeds the umuve-portal project (Root Directory = portal).
# Allowlisting only /platform above silently emptied every portal build from
# 2026-06-30 on (Ready-but-404 deployments — the portal.goumuve.com outage).
!/portal
portal/node_modules
portal/.next
portal/.vercel
