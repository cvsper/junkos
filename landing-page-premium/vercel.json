{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/book",
      "destination": "https://app.goumuve.com/book",
      "permanent": false
    },
    {
      "source": "/book/:path*",
      "destination": "https://app.goumuve.com/book/:path*",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://app.goumuve.com/signup",
      "statusCode": 301
    },
    {
      "source": "/register",
      "destination": "https://app.goumuve.com/register",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/junk-removal/:city/:service",
      "destination": "/pages/junk-removal/:city/:service"
    },
    {
      "source": "/junk-removal/:city",
      "destination": "/pages/junk-removal/:city"
    },
    {
      "source": "/services/:service",
      "destination": "/pages/services/:service"
    },
    {
      "source": "/vs/:comparison",
      "destination": "/pages/vs/:comparison"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug"
    },
    {
      "source": "/operators",
      "destination": "/operators"
    },
    {
      "source": "/privacy",
      "destination": "/privacy"
    },
    {
      "source": "/terms",
      "destination": "/terms"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug"
    },
    {
      "source": "/commercial",
      "destination": "/commercial/index.html"
    },
    {
      "source": "/commercial/:slug",
      "destination": "/commercial/:slug.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/locations",
      "destination": "/locations/index.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/text-quote",
      "destination": "/text-quote.html"
    },
    {
      "source": "/subscribe",
      "destination": "/subscribe.html"
    },
    {
      "source": "/partners/realtors",
      "destination": "/partners/realtors.html"
    },
    {
      "source": "/pay",
      "destination": "/pay.html"
    },
    {
      "source": "/pay/success",
      "destination": "/pay-success.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
